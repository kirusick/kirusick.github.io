doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= `${personalInfo.name} — ${personalInfo.title}`

    style.
      :root {
        --text: #1f2937;
        --muted: #6b7280;
        --accent: #2563eb;
        --bg: #ffffff;
      }

      body {
        margin: 0;
        padding: 40px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, Inter, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
      }

      h1 {
        font-size: 36px;
        margin-bottom: 4px;
      }

      h2 {
        font-size: 20px;
        margin-top: 24px;
        margin-bottom: 12px;
        border-bottom: 2px solid #e5e7eb;
        padding-bottom: 6px;
      }

      h3 {
        font-size: 18px;
        margin: 0;
      }

      .subtitle {
        font-size: 18px;
        color: var(--muted);
        margin-bottom: 12px;
      }

      .contact {
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 32px;
      }

      .contact a {
        color: var(--accent);
        text-decoration: none;
      }

      p {
        margin: 8px 0;
      }

      ul {
        margin: 8px 0 16px 20px;
      }

      li {
        margin-bottom: 6px;
      }

      .job {
        margin-bottom: 40px;
      }

      .job ul {
        margin-top: 8px;
        padding-left: 24px;
        padding-right: 8px;
      }

      .job li {
        line-height: 1.5;
      }

      .job-header {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
      }

      .job-meta {
        font-size: 14px;
        color: var(--muted);
      }

      .skills {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        font-size: 14px;
      }

      .skills span {
        display: block;
      }

      .education {
        margin-bottom: 16px;
      }

      ul.languages {
        display: flex;
        flex-wrap: wrap;
        gap: 0 8px;
        margin: 8px 0 16px 0;
        padding: 0;
        list-style: none;
      }

      ul.languages li {
        margin-bottom: 0;
      }

      ul.languages li:not(:last-child)::after {
        content: " · ";
      }
      
      .avatar {
        width: 128px;
        height: 128px;
        border-radius: 50%;
      }

      header {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .non-breakable {
        white-space: nowrap;
      }

      @media print {
        body {
          padding: 20px;
        }
        .professional-summary h2 {
          margin-top: 12px;
        }
        .cv-pdf {
          display: none;
        }
        .avatar {
          display: none;
        }
        .contact {
          margin-bottom: 12px;
        }
        .page-break { break-after: page; }
        .new-page-padding {
          padding-top: 100px;
        }
      }

      @media (max-width: 720px) {
        body {
          padding: 16px;
        }
        header {
          flex-direction: column;
          text-align: center;
          gap: 0px;
        }
        header h1 {
          margin-top: 12px;
        }
        .contact {
          margin-bottom: 0px;
        }
        ul {
          padding-inline-start: 12px;
        }
      }

  body
    .container

      header
        img.avatar(src=personalInfo.avatar)
        div
          h1= personalInfo.name
          .subtitle= personalInfo.title
          .contact
            | #{personalInfo.location} · #{personalInfo.phone} · 
            a(href=personalInfo.linkedin.url)= personalInfo.linkedin.text
            |  · 
            if personalInfo.github
              a(href=personalInfo.github.url)= personalInfo.github.text
              |  · 
            a(href=`mailto:${personalInfo.email}`)= personalInfo.email
            span.cv-pdf
              |  · 
              a(href="./cv.pdf")
                | CV.pdf

      section.professional-summary
        h2 Professional Summary

        p
          | Senior Frontend Developer with 
          b 9+ years of experience
          |  building scalable web applications using 
          b Next, React 
          | and 
          b TypeScript
          | . I've been building things since I was a kid.
        p
          | My main goal is to move products forward and make developers' lives easier, finding the struggle points and enhancing them.
        p
          | Experienced in building maintainable systems with 
          | strong focus on performance, clean code and great user experience.
          | Skilled in leading teams, driving innovation, and delivering high-impact 
          | solutions in startups and enterprises.

      section
        h2 Core Skills
        .skills
          each skill in skills
            span
              strong= `${skill.category}: `
              = skill.items.join(', ')

      section
        h2 Professional Experience
        each job in jobs
          if job.nextPage
            .page-break
            .new-page-padding
          .job
            .job-header
              h3= `${job.company} — ${job.title}`
              .job-meta= `${job.period} · ${job.location}`
            ul
              each r in job.responsibilities
                li= r

      section
        h2 Education
        each edu in education
          .education
            strong= edu.institution
            br
            = edu.degree

      section
        h2 Languages
        ul.languages
          each lang in languages
            li= `${lang.name}`
